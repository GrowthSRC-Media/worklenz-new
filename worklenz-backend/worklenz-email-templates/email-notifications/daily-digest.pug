- const btn_style = 'display:inline-block;padding:10px 24px;background-color:#1890ff;color:#ffffff;text-decoration:none;border-radius:6px;font-size:14px;font-weight:500;font-family:Helvetica,Arial,sans-serif;'
- const muted = 'color:#6b7280;font-size:13px;'
- const section_heading = 'margin:0 0 10px;font-size:14px;font-weight:600;color:#111827;'
- const task_link = 'color:#1890ff;text-decoration:none;font-size:14px;'
- const task_meta = 'color:#6b7280;font-size:13px;'

mixin taskSection(title, icon, teams)
  if teams && teams.length
    table(width='100%' cellpadding='0' cellspacing='0' style='margin-bottom:20px;')
      tr
        td
          p(style=section_heading)
            if icon === 'clock'
              | &#128337;&nbsp;
            else if icon === 'warn'
              | &#9888;&nbsp;
            else if icon === 'check'
              | &#9989;&nbsp;
            | #{title}

          for $team of teams
            if $team.projects && $team.projects.length
              table(width='100%' cellpadding='0' cellspacing='0' style='margin-bottom:12px;')
                tr
                  td
                    span(style=muted)= $team.name

              for $project of $team.projects
                if $project.tasks && $project.tasks.length
                  table(width='100%' cellpadding='0' cellspacing='0' style='background:#f9fafb;border-radius:6px;border:1px solid #e5e7eb;margin-bottom:12px;')
                    tr
                      td(style='padding:12px 16px;')
                        p(style='margin:0 0 8px;font-size:13px;font-weight:600;color:#111827;')
                          a(href=$project.url target='_blank' style='color:#1890ff;text-decoration:none;')= $project.name

                        for $task of $project.tasks
                          table(width='100%' cellpadding='0' cellspacing='0' style='margin-bottom:4px;')
                            tr
                              td(style='vertical-align:top;width:16px;padding-right:8px;color:#d1d5db;') &#9633;
                              td(style='vertical-align:top;')
                                a(href=$task.url target='_blank' style=task_link)= $task.name
                                if $task.members
                                  span(style=task_meta) &nbsp;#{$task.members}

doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width,initial-scale=1.0')
    title Worklenz - Daily Digest
  body(style='margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial,sans-serif;')
    table(width='100%' cellpadding='0' cellspacing='0' style='background:#f4f5f7;padding:32px 0;')
      tr
        td(align='center')
          table(width='560' cellpadding='0' cellspacing='0' style='background:#ffffff;border-radius:8px;border:1px solid #e5e7eb;')
            //- Header
            tr
              td(style='padding:24px 32px 16px;border-bottom:1px solid #f0f0f0;')
                img(width='32' height='32' src='https://worklenz.s3.amazonaws.com/assets/icon-96x96.png' style='vertical-align:middle;')
                span(style='margin-left:10px;font-size:16px;font-weight:600;color:#111827;vertical-align:middle;') Worklenz

            //- Body
            tr
              td(style='padding:24px 32px;')
                p(style='margin:0 0 4px;font-size:15px;color:#111827;')
                  | #{greeting}
                p(style='margin:0 0 24px;font-size:14px;color:#374151;line-height:1.5;')
                  | #{note}

                +taskSection('Recently assigned to you', 'clock', recently_assigned)
                +taskSection('Overdue', 'warn', overdue)
                +taskSection('Completed today', 'check', recently_completed)

                //- CTA
                table(cellpadding='0' cellspacing='0')
                  tr
                    td
                      a(href=base_url target='_blank' style=btn_style) Go to Worklenz

            //- Footer
            tr
              td(style='padding:16px 32px;border-top:1px solid #f0f0f0;')
                p(style='margin:0;font-size:12px;color:#9ca3af;line-height:1.5;')
                  | Worklenz sends this digest every evening.&nbsp;
                  a(href=settings_url target='_blank' style='color:#6b7280;text-decoration:underline;') Unsubscribe
